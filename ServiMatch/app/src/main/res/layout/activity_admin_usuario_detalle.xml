<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_principal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalle del usuario"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/color_primario_oscuro"
            android:layout_marginBottom="8dp" />

        <!-- DESCRIPCIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Información del usuario registrado"
            android:textSize="14sp"
            android:textColor="@color/texto_secundario"
            android:layout_marginBottom="24dp" />

        <!-- TARJETA DE INFORMACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/blanco"
            android:elevation="3dp">

            <!-- NOMBRE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre completo"
                android:textStyle="bold"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txtDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textSize="18sp"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="20dp" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textStyle="bold"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txtDetalleEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textSize="16sp"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="20dp" />

            <!-- DNI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DNI"
                android:textStyle="bold"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txtDetalleDni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textSize="16sp"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="20dp" />

            <!-- ROL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rol"
                android:textStyle="bold"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txtDetalleRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textSize="16sp"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="20dp" />

            <!-- OFICIO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oficio"
                android:textStyle="bold"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txtDetalleOficio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textSize="16sp"
                android:textColor="@color/texto_principal"
                android:layout_marginBottom="20dp" />

            <!-- UBICACIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubicación"
                android:textStyle="bold"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/txtDetalleUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textSize="16sp"
                android:textColor="@color/texto_principal" />

        </LinearLayout>

        <!-- BOTÓN EDITAR USUARIO -->
        <Button
            android:id="@+id/btnEditarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Editar usuario"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="@color/color_primario_oscuro"
            android:textColor="@color/blanco" />

        <!-- BOTÓN VOLVER -->
        <Button
            android:id="@+id/btnVolverUsuarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Volver a usuarios"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="@color/color_primario"
            android:textColor="@color/blanco" />

    </LinearLayout>

</ScrollView>
