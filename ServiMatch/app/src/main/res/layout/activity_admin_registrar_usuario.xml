<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar usuario"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#082B59"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completá los datos del nuevo usuario."
            android:textSize="14sp"
            android:textColor="#757575"
            android:layout_marginBottom="24dp" />

        <!-- NOMBRE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre completo"
            android:textStyle="bold"
            android:textColor="#212121" />

        <EditText
            android:id="@+id/edtAdminRegistroNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresá el nombre"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp" />

        <!-- EMAIL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textStyle="bold"
            android:textColor="#212121" />

        <EditText
            android:id="@+id/edtAdminRegistroEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp" />

        <!-- DNI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DNI"
            android:textStyle="bold"
            android:textColor="#212121" />

        <EditText
            android:id="@+id/edtAdminRegistroDni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresá el DNI"
            android:inputType="number"
            android:maxLength="8"
            android:layout_marginBottom="16dp" />

        <!-- CONTRASEÑA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textStyle="bold"
            android:textColor="#212121" />

        <EditText
            android:id="@+id/edtAdminRegistroContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresá una contraseña"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <!-- ROL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rol"
            android:textStyle="bold"
            android:textColor="#212121" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usuario estándar"
            android:textSize="16sp"
            android:textColor="#757575"
            android:paddingTop="12dp"
            android:paddingBottom="16dp" />

        <!-- OFICIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oficio"
            android:textStyle="bold"
            android:textColor="#212121" />

        <Spinner
            android:id="@+id/spinnerAdminRegistroOficio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp" />

        <!-- UBICACIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación"
            android:textStyle="bold"
            android:textColor="#212121" />

        <Spinner
            android:id="@+id/spinnerAdminRegistroUbicacion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp" />

        <!-- GUARDAR -->
        <Button
            android:id="@+id/btnAdminGuardarUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar usuario"
            android:textAllCaps="false"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF" />

        <!-- CANCELAR -->
        <Button
            android:id="@+id/btnAdminCancelarRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:backgroundTint="#757575"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
