<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    tools:context=".RegistrarExperienciaActivity">

    <!-- CONTENIDO DEL FORMULARIO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_primario_oscuro"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrar experiencia laboral"
                    android:textColor="@color/blanco"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- FORMULARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- PUESTO DE TRABAJO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Puesto de trabajo"
                        android:textColor="@color/texto_principal"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/etPuestoExperiencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej: Electricista"
                        android:inputType="textCapSentences"
                        android:textColorHint="@color/texto_secundario"
                        android:textColor="@color/texto_principal"
                        android:maxLength="100"
                        android:paddingEnd="32dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:text="*"
                        android:textColor="@color/rojo"
                        android:textSize="18sp"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <!-- EMPRESA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Empresa"
                    android:textColor="@color/texto_principal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/etEmpresaExperiencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej: Instalaciones Córdoba"
                        android:inputType="textCapWords"
                        android:textColorHint="@color/texto_secundario"
                        android:textColor="@color/texto_principal"
                        android:maxLength="100"
                        android:paddingEnd="32dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:text="*"
                        android:textColor="@color/rojo"
                        android:textSize="18sp"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <!-- AÑO DE INICIO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Año de inicio"
                    android:textColor="@color/texto_principal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/etAnioInicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej: 2022"
                        android:inputType="number"
                        android:textColorHint="@color/texto_secundario"
                        android:textColor="@color/texto_principal"
                        android:maxLength="4"
                        android:paddingEnd="32dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:text="*"
                        android:textColor="@color/rojo"
                        android:textSize="18sp"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <!-- AÑO DE FINALIZACIÓN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Año de finalización (opcional)"
                    android:textColor="@color/texto_principal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAnioFin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Ej: 2025"
                    android:inputType="number"
                    android:textColorHint="@color/texto_secundario"
                    android:textColor="@color/texto_principal"
                    android:maxLength="4" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="Dejá este campo vacío si todavía trabajás allí."
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <!-- DESCRIPCIÓN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Descripción"
                    android:textColor="@color/texto_principal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <EditText
                        android:id="@+id/etDescripcionExperiencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Describí las tareas que realizaste..."
                        android:inputType="textCapSentences|textMultiLine"
                        android:textColorHint="@color/texto_secundario"
                        android:textColor="@color/texto_principal"
                        android:maxLength="500"
                        android:paddingEnd="32dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:text="*"
                        android:textColor="@color/rojo"
                        android:textSize="18sp"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <!-- BOTÓN GUARDAR -->
                <Button
                    android:id="@+id/btnGuardarExperiencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/color_primario_oscuro"
                    android:text="Guardar experiencia"
                    android:textColor="@color/blanco" />

                <!-- BOTÓN CANCELAR -->
                <Button
                    android:id="@+id/btnCancelarExperiencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/color_primario"
                    android:text="Cancelar"
                    android:textColor="@color/blanco" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
