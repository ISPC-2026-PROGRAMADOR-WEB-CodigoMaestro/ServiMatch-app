<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    tools:context=".DashboardActivity">

    <!-- CONTENIDO PRINCIPAL DEL DASHBOARD -->
    <ScrollView
        android:id="@+id/scrollDashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barraNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_primario_oscuro"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- LOGO -->
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Logo de ServiMatch"
                    android:src="@drawable/logo" />

                <!-- NOMBRE DE LA APP -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ServiMatch"
                    android:textColor="@color/blanco"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- BIENVENIDA -->
                <TextView
                    android:id="@+id/txtBienvenida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="¡Hola!"
                    android:textColor="@color/blanco"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- SLOGAN -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="El servicio ideal, con la confianza que necesitás"
                    android:textColor="@color/blanco"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- CONTENIDO DE SERVICIOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TÍTULO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="¿Qué servicio necesitás?"
                    android:textColor="@color/texto_principal"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- SUBTÍTULO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Seleccioná un oficio para ver los profesionales disponibles."
                    android:textColor="@color/texto_secundario"
                    android:textSize="16sp" />

                <!-- GRILLA DE OFICIOS -->
                <GridLayout
                    android:id="@+id/gridOficios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:columnCount="2" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- COMPONENTE BARRA DE NAVEGACIÓN -->
    <include
        android:id="@+id/barraNavigation"
        layout="@layout/barra_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
