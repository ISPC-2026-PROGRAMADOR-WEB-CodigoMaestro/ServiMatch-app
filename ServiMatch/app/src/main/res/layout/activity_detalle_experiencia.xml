<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    tools:context=".DetalleExperienciaActivity">

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ENCABEZADO -->
        <TextView
            android:id="@+id/tvTituloDetalleExperiencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_primario_oscuro"
            android:gravity="center"
            android:padding="24dp"
            android:text="Experiencia laboral"
            android:textColor="@color/blanco"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- NOMBRE DEL PROFESIONAL -->
        <TextView
            android:id="@+id/tvNombreDetalleProfesional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center"
            android:textColor="@color/texto_principal"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Alfredo Gomez" />

        <!-- EXPERIENCIAS LABORALES -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- MENSAJE SIN EXPERIENCIAS -->
                <TextView
                    android:id="@+id/tvSinExperienciasProfesional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Este profesional todavía no registró experiencias laborales."
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- CONTENEDOR DE EXPERIENCIAS -->
                <LinearLayout
                    android:id="@+id/contenedorExperienciasProfesional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
