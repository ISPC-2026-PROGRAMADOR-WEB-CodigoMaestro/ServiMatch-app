<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/barraNavegacion"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/blanco"
    android:elevation="12dp"
    android:gravity="center"
    android:orientation="horizontal">

    <!-- INICIO -->
    <LinearLayout
        android:id="@+id/navInicio"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/iconInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌂"
            android:textColor="@color/color_primario"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicio"
            android:textColor="@color/color_primario"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CONTACTO -->
    <LinearLayout
        android:id="@+id/navContacto"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/iconContacto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✉"
            android:textColor="@color/texto_secundario"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/textoContacto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contacto"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- PERFIL -->
    <LinearLayout
        android:id="@+id/navPerfil"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/iconPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/texto_secundario"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>