<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/card_oficio">

    <!-- Nombre de la ciudad -->
    <TextView
        android:id="@+id/txtCiudadUbicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/texto_principal" />

    <!-- Provincia -->
    <TextView
        android:id="@+id/txtProvinciaUbicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="15sp"
        android:textColor="@color/texto_secundario" />

    <!-- Botones de acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditarUbicacion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Editar"
            android:textAllCaps="false"
            android:textColor="@color/blanco"
            android:backgroundTint="@color/color_primario_oscuro" />

        <Button
            android:id="@+id/btnEliminarUbicacion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Eliminar"
            android:textAllCaps="false"
            android:textColor="@color/blanco"
            android:backgroundTint="@color/rojo" />

    </LinearLayout>

</LinearLayout>
