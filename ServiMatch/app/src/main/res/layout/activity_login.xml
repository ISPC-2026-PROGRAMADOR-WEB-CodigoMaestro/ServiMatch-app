<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/fondo_principal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Bienvenido/a!"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvTituloLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ServiMatch"
        android:textColor="@color/color_primario"
        android:textSize="34sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSubtituloLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciá sesión para continuar"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="36dp" />

    <EditText
        android:id="@+id/etUsuario"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Nombre de usuario"
        android:inputType="textPersonName"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@drawable/input_fondo"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@drawable/input_fondo"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        android:layout_marginBottom="24dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnIngresar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="INGRESAR"
        android:textColor="@color/blanco"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/boton_redondeado"
        android:elevation="4dp" />

    <TextView
        android:id="@+id/tvRegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿No tenés una cuenta? Registrate"
        android:textColor="@color/color_primario"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="28dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>